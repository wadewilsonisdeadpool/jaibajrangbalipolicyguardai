OPENAI_API_KEY=your_api_key_here
DATABASE_URL=postgresql+psycopg://policyguard:policyguard_dev@localhost:5432/policyguard
JWT_SECRET=generate_with_python_secrets_token_hex_32

OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://127.0.0.1:11434
# Optional speed-up for thinking models: false = skip hidden reasoning
OLLAMA_THINK=
ROUTER_MODE=hybrid

# Least-privilege DB roles used by the agent database tools
AGENT_DB_READER_PASSWORD=agent_reader_dev
AGENT_DB_WRITER_PASSWORD=agent_writer_dev

# Real email via Gmail (needs 2-Step Verification + an App Password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_MAX_PER_HOUR=10
# Recipients on these domains count as trusted (comma separated)
EMAIL_TRUSTED_DOMAINS=
MAX_UPLOAD_MB=10
OPENWEATHER_API_KEY=
